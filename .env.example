# Iskan — standalone admin dashboard
# This dashboard lives in its own project/deployment but talks to the SAME
# Supabase project as the Iskan public site. Point it at that project's URL and
# service-role key so both see the same properties, users and images.

# Username/password for the seed admin account (created on first run only).
# Change these before the first deploy; they are only used to seed the DB.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign the admin session cookie.
# REQUIRED in production. If unset, a random per-process secret is used and
# everyone is signed out on every restart.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Supabase (the Iskan project) ---
# Copy from the Iskan Supabase project: Settings → API.
SUPABASE_URL=https://your-iskan-project-ref.supabase.co
# Server-only secret. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
# This key is ONLY used by this dashboard; the public site should use a read-only key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for property images. Must match the Iskan schema.
SUPABASE_BUCKET=property-images

# --- Access control ---
# Public Iskan site, so the "View site" link goes somewhere real.
NEXT_PUBLIC_SITE_URL=https://iskan.musamimweb.com

# Optional hard IP allowlist. Comma-separated IPs and/or IPv4 CIDR blocks.
# Leave EMPTY to disable. When set, every request from any other address gets 403.
# Only enable this when the origin is NOT directly reachable (e.g. behind
# Cloudflare / a reverse proxy that overwrites X-Forwarded-For), otherwise the
# headers can be spoofed.
#   ADMIN_ALLOWED_IPS=203.0.113.4,198.51.100.0/24
ADMIN_ALLOWED_IPS=
